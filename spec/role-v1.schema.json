{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/goranai/try-professional/main/spec/role-v1.schema.json",
  "title": "Role definition, spec role/v1",
  "type": "object",
  "required": [
    "spec",
    "id",
    "department",
    "mission",
    "responsibilities",
    "inputs",
    "outputs",
    "allowed_tools",
    "allowed_skill_categories",
    "escalation",
    "reviewer",
    "system_prompt"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "spec": {
      "const": "role/v1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "description": "What people call this role, such as CTO. Changes no permission."
    },
    "department": {
      "$ref": "#/$defs/id"
    },
    "mission": {
      "type": "string",
      "minLength": 1
    },
    "responsibilities": {
      "$ref": "#/$defs/strings"
    },
    "inputs": {
      "$ref": "#/$defs/strings"
    },
    "outputs": {
      "$ref": "#/$defs/strings"
    },
    "allowed_tools": {
      "$ref": "#/$defs/strings"
    },
    "allowed_skill_categories": {
      "$ref": "#/$defs/strings"
    },
    "escalation": {
      "description": "A role reference, or the literal 'human' for the root role only.",
      "oneOf": [
        {
          "$ref": "#/$defs/role_ref"
        },
        {
          "const": "human"
        }
      ]
    },
    "reviewer": {
      "$ref": "#/$defs/role_ref"
    },
    "model_tier": {
      "enum": [
        "executive",
        "standard",
        "fast"
      ],
      "default": "standard"
    },
    "system_prompt": {
      "type": "string",
      "minLength": 1
    },
    "skill_needs": {
      "description": "Short descriptions of the capabilities this role's skills should provide.",
      "$ref": "#/$defs/strings"
    },
    "required_tools": {
      "description": "Tools this role can't work without. Must be a subset of allowed_tools.",
      "$ref": "#/$defs/strings"
    },
    "forbidden_tools": {
      "description": "A skill that needs any of these is never matched to this role.",
      "$ref": "#/$defs/strings"
    },
    "max_skills": {
      "description": "Most skills this role's loadout may hold.",
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 8
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "role_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
