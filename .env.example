# Copy to .env and fill in your own values. Never commit .env.
# trypro.yaml names these variables. It never holds their values.

# The default for every agent: any OpenAI-compatible API.
TRYPRO_LLM_BASE_URL=https://api.example.com/v1
TRYPRO_LLM_API_KEY=your-key-here
TRYPRO_LLM_MODEL=your-model-name
# Optional: room for one reply, to start with. A reply that runs out gets twice the room, up to 128000.
# TRYPRO_LLM_MAX_OUTPUT_TOKENS=16000

# Optional: lets `trypro init` search GitHub for skills. Only skill_needs phrases are sent. Read access is enough.
# GITHUB_TOKEN=your-github-token

# Optional: web search for research roles. Also turn it on in trypro.yaml. Off by default.
# TRYPRO_SEARCH_API_KEY=your-search-key

# Optional: talk to your company from Telegram with `trypro telegram`. Make a bot with @BotFather.
# Only the chats listed here can give it work.
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_ALLOWED_CHAT_IDS=your-chat-id

# Optional: extra keys for per-agent overrides in org/org.yaml, for example:
# QA_LLM_KEY=your-other-key
